[gd_resource type="Resource" script_class="SkillData" format=3]

[ext_resource type="Script" path="res://scripts/data/skill_data.gd" id="1_skill"]
[ext_resource type="Script" path="res://scripts/data/effects/effect_data.gd" id="2_effect"]
[ext_resource type="Script" path="res://scripts/data/effects/damage_effect.gd" id="3_damage"]
[ext_resource type="Script" path="res://scripts/data/effects/slow_effect.gd" id="4_slow"]
[ext_resource type="Script" path="res://scripts/data/effects/projectile_effect.gd" id="5_projectile"]

[sub_resource type="Resource" id="Resource_damage"]
script = ExtResource("3_damage")
amount = 40

[sub_resource type="Resource" id="Resource_slow"]
script = ExtResource("4_slow")
pct = 0.4
duration_s = 2.0

[sub_resource type="Resource" id="Resource_projectile"]
